{
  "manifest_version": 3,
  "name": "TimeFit for YouTube",
  "version": "1.0.0",
  "description": "Only shows YouTube videos you have time to finish before your break ends, with live sidebar pruning and smart Shorts guardrails.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TimeFit for YouTube",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["dist/content.js"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
